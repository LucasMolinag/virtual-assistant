<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vela" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Theme.Vela.Alarm" parent="Theme.Vela">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Vella.Listen" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
