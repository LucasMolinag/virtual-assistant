<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lane_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <FrameLayout
        android:id="@+id/span_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView android:id="@+id/span0" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span1" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span2" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span3" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span4" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span5" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
            <TextView android:id="@+id/span6" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:id="@+id/span_title"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="start|center_vertical"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/chip_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lane0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lane6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_ink"
            android:textSize="12sp"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
